root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
charset = utf-8

[*.ps1]
charset = utf-8

[*.bat]
charset = utf-8

[*.cmd]
charset = utf-8

[*.md]
charset = utf-8

[*.json]
charset = utf-8

[*.sql]
charset = utf-8

[.env.example]
charset = utf-8
