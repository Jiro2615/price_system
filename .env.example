# .env.example

# Rakuten API credentials by store.
RAKUTEN_1_SERVICE_SECRET=
RAKUTEN_1_LICENSE_KEY=
RAKUTEN_2_SERVICE_SECRET=
RAKUTEN_2_LICENSE_KEY=

# Optional Rakuten Item API delivery method set ID. Leave blank when not configured.
RAKUTEN_1_SHIPPING_METHOD_GROUP=
RAKUTEN_2_SHIPPING_METHOD_GROUP=1

# Rakuten delivery lead-time IDs used when creating items.
# NORMAL is used for in-stock items; BACK_ORDER is used when the item is back-ordered.
RAKUTEN_1_NORMAL_DELIVERY_DATE_ID=1
RAKUTEN_1_BACK_ORDER_DELIVERY_DATE_ID=1
RAKUTEN_2_NORMAL_DELIVERY_DATE_ID=1
RAKUTEN_2_BACK_ORDER_DELIVERY_DATE_ID=1

# Store-scoped Cabinet config for listing image upload.
# rakuten_1 has code defaults; rakuten_2 should be configured explicitly.
RAKUTEN_2_CABINET_FOLDER_ID=
RAKUTEN_2_CABINET_FOLDER_NAME=
RAKUTEN_2_CABINET_FOLDER_PATH=
RAKUTEN_2_CABINET_SHOP_URL=
RAKUTEN_2_CABINET_FOLDER_NODE=

# Rakuten SFTP / WinSCP credentials by store.
RAKUTEN_1_SFTP_HOST=upload.rakuten.ne.jp
RAKUTEN_1_SFTP_PORT=22
RAKUTEN_1_SFTP_USER=
RAKUTEN_1_SFTP_PASSWORD=
RAKUTEN_1_SFTP_BATCH_DIR=/ritem/batch
RAKUTEN_1_SFTP_LOG_DIR=/ritem/logs
# 動作確認中は * でもよいが、本番ではWinSCPのfingerprintを指定する
RAKUTEN_1_SFTP_HOSTKEY=*

# Store 2 SFTP / WinSCP credentials.
RAKUTEN_2_SFTP_HOST=upload.rakuten.ne.jp
RAKUTEN_2_SFTP_PORT=22
RAKUTEN_2_SFTP_USER=
RAKUTEN_2_SFTP_PASSWORD=
RAKUTEN_2_SFTP_BATCH_DIR=/ritem/batch
RAKUTEN_2_SFTP_LOG_DIR=/ritem/logs
RAKUTEN_2_SFTP_HOSTKEY=*

# Optional
WINSCP_COM=C:\Program Files (x86)\WinSCP\WinSCP.com

# DB
# Prefer PRICE_SYSTEM_DB_* for shared DB access from multiple PCs.
# Legacy DB_* names remain available for compatibility.
# QNAP/Tailscale example:
# PRICE_SYSTEM_DB_HOST=100.x.y.z
# or PRICE_SYSTEM_DB_HOST=qnap-name.tailnet-name.ts.net
# PRICE_SYSTEM_DB_PORT=5432
# PRICE_SYSTEM_DB_NAME=price_system
# PRICE_SYSTEM_DB_USER=price_app
PRICE_SYSTEM_DB_HOST=localhost
PRICE_SYSTEM_DB_PORT=5432
PRICE_SYSTEM_DB_NAME=price_system
PRICE_SYSTEM_DB_USER=price_app
PRICE_SYSTEM_DB_PASSWORD=

# Legacy compatibility keys
DB_HOST=localhost
DB_PORT=5432
DB_NAME=price_system
DB_USER=price_app
DB_PASSWORD=
# 医薬部外品を自動出品する場合の必須記載事項（店舗ごとに設定）
RAKUTEN_2_COMPLIANCE_ADVERTISER_NAME=
RAKUTEN_2_COMPLIANCE_ADVERTISER_PHONE=
