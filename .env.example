# .env.example

# Rakuten API
# Preferred per-store keys
RAKUTEN_1_SERVICE_SECRET=
RAKUTEN_1_LICENSE_KEY=
RAKUTEN_2_SERVICE_SECRET=
RAKUTEN_2_LICENSE_KEY=

# Optional store display/link settings used by the Web Orchestrator.
RAKUTEN_2_SHOP_URL=
RAKUTEN_2_CABINET_SHOP_URL=
RAKUTEN_2_CABINET_FOLDER=r_2025042547/listing_test

# Legacy fallback for rakuten_1 only
RAKUTEN_SERVICE_SECRET=
RAKUTEN_LICENSE_KEY=

# Rakuten SFTP / WinSCP
RAKUTEN_SFTP_HOST=upload.rakuten.ne.jp
RAKUTEN_SFTP_PORT=22
RAKUTEN_SFTP_USER=
RAKUTEN_SFTP_PASSWORD=
RAKUTEN_SFTP_BATCH_DIR=/ritem/batch
RAKUTEN_SFTP_LOG_DIR=/ritem/logs
# 動作確認中は * でもよいが、本番ではWinSCPのfingerprintを指定する
RAKUTEN_SFTP_HOSTKEY=*

# Store-scoped SFTP credentials.
# rakuten_1 falls back to the shared keys above; rakuten_2 should be configured explicitly.
RAKUTEN_2_SFTP_HOST=upload.rakuten.ne.jp
RAKUTEN_2_SFTP_PORT=22
RAKUTEN_2_SFTP_USER=
RAKUTEN_2_SFTP_PASSWORD=
RAKUTEN_2_SFTP_BATCH_DIR=/ritem/batch
RAKUTEN_2_SFTP_LOG_DIR=/ritem/logs
RAKUTEN_2_SFTP_HOSTKEY=*

# Optional
WINSCP_COM=C:\Program Files (x86)\WinSCP\WinSCP.com

# DB
# Prefer PRICE_SYSTEM_DB_* for shared DB access from multiple PCs.
# Legacy DB_* names remain available for compatibility.
# QNAP/Tailscale example:
# PRICE_SYSTEM_DB_HOST=100.x.y.z
# or PRICE_SYSTEM_DB_HOST=qnap-name.tailnet-name.ts.net
# PRICE_SYSTEM_DB_PORT=5432
# PRICE_SYSTEM_DB_NAME=price_system
# PRICE_SYSTEM_DB_USER=price_app
PRICE_SYSTEM_DB_HOST=localhost
PRICE_SYSTEM_DB_PORT=5432
PRICE_SYSTEM_DB_NAME=price_system
PRICE_SYSTEM_DB_USER=price_app
PRICE_SYSTEM_DB_PASSWORD=

# Legacy compatibility keys
DB_HOST=localhost
DB_PORT=5432
DB_NAME=price_system
DB_USER=price_app
DB_PASSWORD=
